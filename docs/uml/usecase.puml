@startuml
left to right direction
actor "User" as U
database "MySQL\n(Users, Colors)" as DB
rectangle "COLORS Web Application" {
  usecase "Log In" as UC1
  usecase "Log Out" as UC2
  usecase "Add Color" as UC3
  usecase "Search Colors" as UC4
  usecase "Validate Credentials" as UC5
  usecase "Check Session Cookie" as UC6
}
U --> UC1
U --> UC2
U --> UC3
U --> UC4
UC1 ..> UC5 : <<include>>
UC3 ..> UC6 : <<include>>
UC4 ..> UC6 : <<include>>
UC5 --> DB
UC3 --> DB
UC4 --> DB
@enduml
